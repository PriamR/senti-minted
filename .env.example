# ── Senti-Minted API keys ───────────────────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored. Values here override
# any same-named OS environment variable (see app/config.py).

# DeepSeek (sentiment LLM) — OpenAI-compatible. platform.deepseek.com
DEEPSEEK_API_KEY=

# Twitch / IGDB OAuth (client-credentials). Register an app at dev.twitch.tv/console.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API v3 key (Google Cloud console).
YOUTUBE_DATA_API_KEY=

# IsThereAnyDeal (pricing). Register an app at isthereanydeal.com.
ITAD_API_KEY=

# RAWG (metadata). rawg.io/apidocs
RAWG_API_KEY=

# Steam Web API key (for ISteamNews etc.). appreviews/appdetails need no key.
STEAM_WEB_API_KEY=

# Reddit "script" OAuth app (pending — fill when available).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SentiMinted/0.1 by u/your_username
# Optional: only needed for user-context (password grant); blank = read-only app.
REDDIT_USERNAME=
REDDIT_PASSWORD=
